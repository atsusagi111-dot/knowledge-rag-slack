# ===== ローカル開発用（Supabase / OpenAI 無しで一通り動かす）=====
# 1. 別のターミナルで  npx tsx scripts/local-db.ts  を起動
# 2. このファイルを .env にコピー
# 3. npm run db:migrate → npm run ingest → npm run search -- --user UALLDEPTS "質問"

DATABASE_URL_INGEST=postgresql://postgres@127.0.0.1:54329/postgres
DATABASE_URL_BOT=postgresql://postgres@127.0.0.1:54329/postgres
RAG_BOT_PASSWORD=local
# ローカル PGlite は TLS 非対応
DATABASE_SSL=disable

# 偽の Embedding / LLM（OpenAI を呼ばない。文字の並びから作る簡易ベクトルなので精度は参考程度）
# fake のときは OPENAI_API_KEY は読まれない
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake

SEARCH_TOP_K=8
SIMILARITY_THRESHOLD=0.20
DOCS_DIR=./data/docs
