# ===== Supabase（Project Settings → Database → Connection string → Session pooler）=====
# 取り込み・マイグレーション用。postgres ユーザーの URL。ボットには渡さない
DATABASE_URL_INGEST=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# ボット・検索用。0003_roles_rls.sql で作る rag_bot ロールの URL（パスワードは .env の RAG_BOT_PASSWORD と同じ）
DATABASE_URL_BOT=postgresql://rag_bot.xxxxxxxx:RAG_BOT_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# マイグレーションが rag_bot ロールを作るときに使うパスワード（自分で決める）
RAG_BOT_PASSWORD=change-me

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-5-nano

# ===== 検索パラメータ =====
# 上位何件のチャンクを回答の材料にするか
SEARCH_TOP_K=5
# この類似度（0〜1）未満なら「該当なし」。Day7 の評価で校正する
SIMILARITY_THRESHOLD=0.40

# ===== Slack（api.slack.com/apps）=====
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ===== 取り込み元 =====
DOCS_DIR=./data/docs
